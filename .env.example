# ==========================================
# Configuración de Base de Datos (MySQL)
# ==========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=deposito

# ==========================================
# Configuración de WhatsApp (Opcional)
# Proveedores disponibles: meta | evolution | twilio
# ==========================================
WHATSAPP_PROVIDER=meta

# Opción 1: Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Opción 2: Evolution API / Gateway
# WHATSAPP_GATEWAY_URL=http://localhost:8080
# WHATSAPP_GATEWAY_APIKEY=tu_api_key
# WHATSAPP_GATEWAY_INSTANCE=default

# Opción 3: Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
